      "(218889, 17) (6, 9) (6, 3)\n"
     ]
    }
   ],
   "source": [
    "flights = pd.read_sql(text(f'SELECT * FROM {pg_schema}.flights'), engine)\n",
    "airports = pd.read_sql(text(f\"SELECT * FROM {pg_schema}.airports WHERE faa IN {tuple(AIRPORTS)}\"), engine)\n",
    "raw = pd.read_sql(text(f'SELECT airport_code, station_id, extracted_data FROM {pg_schema}.weather_daily_raw'), engine)\n",
    "print(flights.shape, airports.shape, raw.shape)"
   ]
