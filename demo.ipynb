   "source": [
    "# \"normal\" cancel rate = average from december 01 to december 20\n",
    "baseline = (merged[merged['flight_date'].between('2022-12-01', '2022-12-20')]\n",
    "            .groupby('origin')['cancel_rate'].mean())\n",
    "\n",
    "after = merged[merged['flight_date'] > EVENT_END]\n",
    "\n",
    "recovery = {}\n",
    "for ap in AIRPORTS:\n",
    "    d = after[after['origin'] == ap].sort_values('flight_date')\n",
    "    ok = d[d['cancel_rate'] <= baseline[ap] + 0.05]   # tolérance de 5 points\n",
    "    recovery[ap] = ok['flight_date'].min()\n",
    "\n",
    "rec = pd.DataFrame({'baseline_cancel_%': (baseline * 100).round(1),\n",
    "                    'back_to_normal': pd.Series(recovery)})\n",
    "rec['days_after_storm'] = (rec['back_to_normal'] - EVENT_END).dt.days\n",
    "rec"
   ]
  },
