   ],
   "source": [
    "# Three non-overlapping periods: before / storm / after\n",
    "periods = {\n",
    "    'Before (1-20 Dec)': ('2022-12-01', '2022-12-20'),\n",
    "    'Storm (22-29 Dec)': ('2022-12-22', '2022-12-29'),\n",
    "    'After (2-15 Jan)': ('2023-01-02', '2023-01-15'),\n",
    "}\n",
    "rows = []\n",
    "for name, (a, b) in periods.items():\n",
    "    p = merged[merged['flight_date'].between(a, b)]\n",
    "    g = p.groupby('origin').agg(cancel_rate=('cancel_rate', 'mean'),\n",
    "                                tmin=('tmin', 'mean'), wspd=('wspd', 'mean'))\n",
    "    g['period'] = name\n",
    "    rows.append(g.reset_index())\n",
    "cmp = pd.concat(rows)\n",
    "cmp.pivot(index='origin', columns='period', values=['cancel_rate', 'tmin', 'wspd']).round(2)"
   ]
  },
