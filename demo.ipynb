    "frames = []\n",
    "for _, r in raw.iterrows():\n",
    "    d = r['extracted_data']\n",
    "    if isinstance(d, str):\n",
    "        d = json.loads(d)\n",
    "    tmp = pd.DataFrame(d['data'])\n",
    "    tmp['airport_code'] = r['airport_code']\n",
    "    frames.append(tmp)\n",
    "weather = pd.concat(frames, ignore_index=True)\n",
    "weather['date'] = pd.to_datetime(weather['date'])\n",
    "print(weather.shape)\n",
    "weather.head()"
   ]
