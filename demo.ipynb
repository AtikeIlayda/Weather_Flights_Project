   "source": [
    "#  let's catch each response in a dictionary. create an empty dictionary with the following keys:\n",
    "\n",
    "weather_dict = {'extracted_at':[], \n",
    "                'airport_code':[], \n",
    "                'station_id':[], \n",
    "                'extracted_data':[]\n",
    "               }\n",
    "\n",
    "# API CALL daily (station) - for the syntax: see the rapidapi interface\n",
    "\n",
    "url = \"https://meteostat.p.rapidapi.com/stations/daily\"\n",
    "\n",
    "headers = {\n",
    "        \"X-RapidAPI-Key\": api_key,\n",
    "        \"X-RapidAPI-Host\": \"meteostat.p.rapidapi.com\"\n",
    "}\n",
    "\n",
    "# for-loop for the querystrings\n",
    "for airport, station_id in airport_staids.items():\n",
    "   \n",
    "    querystring = {\n",
    "        \"station\":station_id\n",
    "        ,\"start\":start\n",
    "        ,\"end\":end\n",
    "        ,\"model\":\"true\"\n",
    "    }\n",
    "    \n",
    "    # making one call with the current querystring\n",
    "    response = requests.get(url, headers=headers, params=querystring)\n",
    "    print(response.json())\n",
    "\n",
    "    # appending data to the dictionary:\n",
    "    weather_dict['extracted_at'].append(datetime.now())                # timestamp of the call\n",
    "    weather_dict['airport_code'].append(airport)                       # airport code, e.g. 'JFK'\n",
    "    weather_dict['station_id'].append(station_id)                      # weather Station ID\n",
    "    weather_dict['extracted_data'].append(json.loads(response.text))   # JSON string\n"
   ]
  },
