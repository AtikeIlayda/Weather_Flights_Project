   "source": [
    "daily = (flights.groupby(['origin', 'flight_date'])\n",
    "         .agg(n_flights=('origin', 'size'),\n",
    "              n_cancelled=('cancelled', 'sum'),\n",
    "              mean_dep_delay=('dep_delay', 'mean'))\n",
    "         .reset_index())\n",
    "daily['cancel_rate'] = daily['n_cancelled'] / daily['n_flights']\n",
    "\n",
    "merged = daily.merge(weather, left_on=['origin', 'flight_date'],\n",
    "                     right_on=['airport_code', 'date'], how='left')\n",
    "merged['in_event'] = merged['flight_date'].between(EVENT_START, EVENT_END)\n",
    "print(merged.shape, '| rows without weather:', merged['tmin'].isna().sum())\n",
    "merged.head()"
   ]
  },
