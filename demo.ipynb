    "import json\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from sqlalchemy import create_engine, text\n",
    "from dotenv import dotenv_values\n",
    "\n",
    "config = dotenv_values()\n",
    "pg_schema = 'team_d'\n",
    "url = f\"postgresql://{config['POSTGRES_USER']}:{config['POSTGRES_PASS']}@{config['POSTGRES_HOST']}:{config['POSTGRES_PORT']}/{config['POSTGRES_DB']}\"\n",
    "engine = create_engine(url, echo=False)\n",
    "\n",
    "AIRPORTS = ['BUF', 'ORD', 'MDW', 'LGA', 'DEN', 'BNA']\n",
    "EVENT_START, EVENT_END = pd.Timestamp('2022-12-22'), pd.Timestamp('2022-12-29')"
   ]
  },
